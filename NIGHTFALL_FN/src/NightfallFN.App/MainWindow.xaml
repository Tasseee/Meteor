<Window x:Class="NightfallFN.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NIGHTFALL FN" Height="740" Width="1120" MinHeight="620" MinWidth="900"
 WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}"
 KeyDown="Window_KeyDown">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="13" Padding="15">
      <DockPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource AccentBrush}">
            <TextBlock Text="N" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="11,0,0,0">
            <TextBlock Text="NIGHTFALL" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="FORTNITE EDITION" FontSize="9" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold"/>
          </StackPanel>
        </StackPanel>
        <TextBlock DockPanel.Dock="Right" Text="BUILD 0.1.0  ·  DESKTOP COMPANION" FontSize="9" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" Margin="0,14,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="*"/><ColumnDefinition Width="245"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="12" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="WORKSPACE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="7,8,0,12"/>
          <Button Content="◈   Overview" HorizontalContentAlignment="Left" Click="Overview_Click" Margin="0,2"/>
          <Button Content="▦   Visuals" HorizontalContentAlignment="Left" Tag="Visuals" Click="Category_Click" Margin="0,2"/>
          <Button Content="◇   Misc" HorizontalContentAlignment="Left" Tag="Misc" Click="Category_Click" Margin="0,2"/>
          <Button Content="⚙   Client" HorizontalContentAlignment="Left" Tag="Client" Click="Category_Click" Margin="0,2"/>
          <Separator Margin="4,15" Background="{StaticResource BorderBrushSoft}"/>
          <TextBlock Text="TOOLS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="7,4,0,10"/>
          <Button Content="⌘   Queue Profile" HorizontalContentAlignment="Left" Click="QueueProfile_Click" Margin="0,2"/>
          <Border Background="#FF211E2B" CornerRadius="9" Padding="10" Margin="4,22,4,0">
            <TextBlock Text="STEVE  /  NIGHT WATCH" Foreground="{StaticResource AccentSoftBrush}" FontSize="10" FontWeight="Bold"/>
            <TextBlock Text="A familiar block-world spirit, watching over your desktop." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
          </Border>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="17">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel>
            <StackPanel>
              <TextBlock x:Name="PageTitle" Text="Overview" FontSize="23" FontWeight="Bold"/>
              <TextBlock x:Name="PageSubtitle" Text="Your NIGHTFALL workspace." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" Text="● LOCAL CLIENT" Foreground="{StaticResource AccentSoftBrush}" FontSize="9" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBox x:Name="SearchBox" Grid.Row="1" Height="36" Margin="0,15,0,12" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/>
          <Border x:Name="MetricsCard" Grid.Row="2" Background="#FF211E2B" CornerRadius="10" Padding="12" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="SYSTEM CPU" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="CpuText" Text="Telemetry pending" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="SYSTEM RAM" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="MemoryText" Text="Telemetry pending" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="LOCAL TIME" Foreground="{StaticResource MutedBrush}" FontSize="9"/><TextBlock x:Name="ClockText" Text="--:--:--" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
            </Grid>
          </Border>
          <StackPanel Grid.Row="3">
            <TextBlock Text="MODULES" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="1,0,0,8"/>
            <ListBox x:Name="ModuleList" Background="Transparent" BorderThickness="0" SelectionChanged="ModuleList_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Background="#FF1A1923" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,0,0,7">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <DockPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource AccentSoftBrush}" FontSize="8" Margin="9,3,0,0"/></DockPanel>
                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,8,0"/>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding IsEnabled, StringFormat=On: {0}}" Foreground="{StaticResource AccentSoftBrush}" FontSize="9" VerticalAlignment="Center" Margin="8,0,2,0"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="14" Margin="12,0,0,0">
        <StackPanel>
          <TextBlock Text="INSPECTOR" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold"/>
          <TextBlock x:Name="InspectorName" Text="Select a module" FontSize="17" FontWeight="Bold" Margin="0,15,0,5"/>
          <TextBlock x:Name="InspectorDescription" Text="Choose a module to inspect its status." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap"/>
          <Separator Margin="0,16" Background="{StaticResource BorderBrushSoft}"/>
          <TextBlock Text="STATUS" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold"/>
          <TextBlock x:Name="InspectorStatus" Text="—" FontSize="12" Margin="0,6,0,12"/>
          <Button x:Name="ToggleButton" Content="Enable / Disable" Click="ToggleSelected_Click"/>
          <Button Content="Open Queue Profile" Click="QueueProfile_Click" Margin="0,7,0,0"/>
          <Border Background="#FF211E2B" CornerRadius="8" Padding="10" Margin="0,19,0,0">
            <TextBlock Text="Chest Debug needs map-authored UEFN markers. Player ESP is not part of NIGHTFALL FN." Foreground="{StaticResource AccentSoftBrush}" FontSize="10" TextWrapping="Wrap"/>
          </Border>
        </StackPanel>
      </Border>
    </Grid>
    <DockPanel Grid.Row="2">
      <TextBlock Text="NIGHTFALL FN  /  MINIMAL DARK" Foreground="{StaticResource MutedBrush}" FontSize="9" VerticalAlignment="Center"/>
      <TextBlock DockPanel.Dock="Right" Text="RIGHT SHIFT · WHEN FOCUSED" Foreground="{StaticResource MutedBrush}" FontSize="9" VerticalAlignment="Center"/>
    </DockPanel>
  </Grid>
</Window>
